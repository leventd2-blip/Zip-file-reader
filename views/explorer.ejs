<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ZipVault Workspace — Explorer Engine</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
    code, pre, .font-mono { font-family: 'JetBrains Mono', monospace; }
  </style>
</head>
<body class="bg-black text-white min-h-screen flex flex-col font-sans antialiased selection:bg-neutral-800">

  <!-- App Header -->
  <header class="border-b border-neutral-900 bg-neutral-950 px-6 py-3 flex justify-between items-center">
    <div class="flex items-center space-x-3">
      <a href="https://zipvault.ddns.net" class="bg-neutral-900 border border-neutral-800 p-2 rounded-xl text-white hover:bg-neutral-800 transition">
        <i data-lucide="archive" class="w-5 h-5"></i>
      </a>
      <div>
        <h1 class="font-bold text-sm tracking-tight">ZipVault Explorer</h1>
        <p class="text-[10px] text-neutral-500 font-mono">app.zipvault.ddns.net</p>
      </div>
    </div>

    <div id="fileMeta" class="hidden text-xs text-neutral-400 flex items-center space-x-4 bg-black border border-neutral-800 px-4 py-1.5 rounded-xl font-mono">
      <span>File: <strong id="metaName" class="text-white">--</strong></span>
      <span>Size: <strong id="metaSize" class="text-neutral-300">--</strong></span>
      <span>Entries: <strong id="metaCount" class="text-neutral-300">--</strong></span>
    </div>
  </header>

  <!-- Main Explorer Grid -->
  <main class="flex-1 grid grid-cols-12 overflow-hidden h-[calc(100vh-57px)]">
    <!-- Sidebar / Dropzone -->
    <section class="col-span-12 md:col-span-4 border-r border-neutral-900 flex flex-col bg-black">
      <div class="p-4 border-b border-neutral-900">
        <label id="dropzone" class="border-2 border-dashed border-neutral-800 hover:border-neutral-600 bg-neutral-950 rounded-xl p-4 flex flex-col items-center justify-center cursor-pointer transition text-center">
          <i data-lucide="upload-cloud" class="w-6 h-6 text-neutral-400 mb-1"></i>
          <span class="text-xs font-semibold text-white">Drop .ZIP File Here</span>
          <span class="text-[10px] text-neutral-500">or click to browse local files</span>
          <input type="file" id="zipInput" accept=".zip" class="hidden">
        </label>
      </div>

      <div class="p-3 border-b border-neutral-900 bg-neutral-950">
        <div class="relative">
          <i data-lucide="search" class="w-3.5 h-3.5 text-neutral-500 absolute left-3 top-2.5"></i>
          <input type="text" id="searchInput" placeholder="Filter archive paths..." class="w-full bg-black border border-neutral-800 rounded-lg pl-8 pr-3 py-1 text-xs text-white focus:outline-none focus:border-neutral-600">
        </div>
      </div>

      <div id="fileTree" class="flex-1 overflow-y-auto p-2 space-y-0.5 font-mono text-xs">
        <div class="p-12 text-center text-neutral-600 flex flex-col items-center">
          <i data-lucide="folder-closed" class="w-8 h-8 mb-2 opacity-40"></i>
          <span>No archive loaded</span>
        </div>
      </div>
    </section>

    <!-- Content Workspace -->
    <section class="col-span-12 md:col-span-8 bg-black flex flex-col">
      <div class="h-11 border-b border-neutral-900 px-4 flex items-center justify-between bg-neutral-950">
        <div class="flex items-center space-x-2 text-xs font-mono text-neutral-300 truncate max-w-[70%]">
          <i data-lucide="file-code" class="w-4 h-4 text-neutral-400 shrink-0"></i>
          <span id="activeFilePath" class="truncate">Select a file to inspect</span>
        </div>

        <div class="flex items-center space-x-2">
          <span id="activeFileMime" class="text-[10px] font-mono bg-neutral-900 border border-neutral-800 text-neutral-400 px-2 py-0.5 rounded">--</span>
          <button id="downloadBtn" class="hidden bg-white hover:bg-neutral-200 text-black font-semibold text-xs px-3 py-1 rounded-lg flex items-center gap-1.5 transition">
            <i data-lucide="download" class="w-3.5 h-3.5"></i> Extract
          </button>
        </div>
      </div>

      <div id="previewArea" class="flex-1 overflow-auto p-4 flex items-center justify-center">
        <div class="text-center text-neutral-600 flex flex-col items-center max-w-sm">
          <i data-lucide="terminal" class="w-8 h-8 mb-2 opacity-40"></i>
          <p class="text-xs font-medium text-neutral-400">Preview Engine Ready</p>
          <p class="text-[11px] text-neutral-600 mt-1">Select any file from the tree to inspect raw contents instantly.</p>
        </div>
      </div>
    </section>
  </main>

  <script src="/js/app.js"></script>
</body>
</html>