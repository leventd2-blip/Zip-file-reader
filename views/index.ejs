<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ZipVault — High Performance ZIP Inspector</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
    code, pre, .font-mono { font-family: 'JetBrains Mono', monospace; }
  </style>
</head>
<body class="bg-black text-white min-h-screen flex flex-col antialiased selection:bg-neutral-800 selection:text-white">

  <!-- Top Navigation Header -->
  <header class="border-b border-neutral-900 bg-black/80 backdrop-blur sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="bg-neutral-900 border border-neutral-800 p-2 rounded-xl text-white">
          <i data-lucide="archive" class="w-5 h-5"></i>
        </div>
        <span class="font-bold text-lg tracking-tight">ZipVault</span>
      </div>

      <div class="flex items-center space-x-4">
        <a href="#app" class="bg-white hover:bg-neutral-200 text-black font-semibold text-xs px-4 py-2 rounded-xl transition-all shadow-sm">
          Launch Inspector
        </a>
      </div>
    </div>
  </header>

  <!-- Hero Section (DecibelNode Style) -->
  <section class="py-20 px-6 text-center max-w-4xl mx-auto flex flex-col items-center">
    <!-- WIP Badge -->
    <div class="inline-flex items-center gap-2 bg-[#2a1708] border border-[#f97316]/30 text-[#f97316] px-4 py-1.5 rounded-full text-xs font-medium mb-8">
      <i data-lucide="alert-triangle" class="w-4 h-4"></i>
      <span>This project is high performance & fully client-side.</span>
    </div>

    <!-- Main Title -->
    <h1 class="text-4xl md:text-6xl font-extrabold text-white tracking-tight leading-tight mb-6">
      Free ZIP File Explorer
    </h1>

    <p class="text-neutral-400 text-base md:text-lg max-w-2xl font-normal leading-relaxed mb-8">
      ZipVault inspects your archive files instantly inside your browser, showing every folder, file, and code preview—without uploading your data to any server.
    </p>

    <!-- Call to Action Button -->
    <a href="#workspace" class="bg-white hover:bg-neutral-200 text-black font-semibold text-sm px-6 py-3 rounded-xl inline-flex items-center gap-2 transition-all shadow-lg">
      <i data-lucide="arrow-up-right" class="w-4 h-4"></i> Open Workspace
    </a>
  </section>

  <!-- Feature Grid (DecibelNode Style Cards) -->
  <section class="py-12 px-6 max-w-6xl mx-auto w-full">
    <div class="text-center mb-12">
      <h2 class="text-2xl md:text-3xl font-bold text-white tracking-tight">Why choose ZipVault?</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Card 1 -->
      <div class="bg-neutral-950 border border-neutral-900 rounded-2xl p-6 flex flex-col justify-between hover:border-neutral-800 transition">
        <div>
          <span class="inline-block bg-neutral-900 text-neutral-400 border border-neutral-800 px-3 py-1 rounded-full text-[11px] font-medium mb-6">
            01 / Free
          </span>
          <h3 class="text-xl font-bold text-white mb-3">Free, No Catches</h3>
          <p class="text-neutral-400 text-sm leading-relaxed">
            Inspect archives of any size for free. No dynamic payload limits, no accounts, and no paywalls.
          </p>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="bg-neutral-950 border border-neutral-900 rounded-2xl p-6 flex flex-col justify-between hover:border-neutral-800 transition">
        <div>
          <span class="inline-block bg-neutral-900 text-neutral-400 border border-neutral-800 px-3 py-1 rounded-full text-[11px] font-medium mb-6">
            02 / Privacy
          </span>
          <h3 class="text-xl font-bold text-white mb-3">100% Local & Private</h3>
          <p class="text-neutral-400 text-sm leading-relaxed">
            We track zero metrics and never send your files to external servers. Your ZIP contents stay strictly inside your browser memory.
          </p>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="bg-neutral-950 border border-neutral-900 rounded-2xl p-6 flex flex-col justify-between hover:border-neutral-800 transition">
        <div>
          <span class="inline-block bg-neutral-900 text-neutral-400 border border-neutral-800 px-3 py-1 rounded-full text-[11px] font-medium mb-6">
            03 / Code Engine
          </span>
          <h3 class="text-xl font-bold text-white mb-3">Instant Previews</h3>
          <p class="text-neutral-400 text-sm leading-relaxed">
            Click on any script, Python file, image, or config to view its contents and code directly inside our built-in viewer.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- Interactive Workspace Section -->
  <section id="workspace" class="py-12 px-6 max-w-7xl mx-auto w-full flex-1 flex flex-col">
    <div class="border border-neutral-900 bg-neutral-950 rounded-2xl overflow-hidden flex flex-col min-h-[600px] shadow-2xl">
      
      <!-- Workspace Header Bar -->
      <div class="bg-neutral-900/60 border-b border-neutral-900 px-6 py-4 flex flex-col md:flex-row gap-4 justify-between items-center">
        <div class="flex items-center space-x-3">
          <i data-lucide="folder-tree" class="w-5 h-5 text-neutral-400"></i>
          <span class="font-bold text-sm text-white">Archive Workspace</span>
        </div>

        <div id="fileMeta" class="hidden text-xs text-neutral-400 flex items-center space-x-4 bg-black border border-neutral-800 px-4 py-2 rounded-xl">
          <span>File: <strong id="metaName" class="text-white">--</strong></span>
          <span>Size: <strong id="metaSize" class="text-neutral-300">--</strong></span>
          <span>Entries: <strong id="metaCount" class="text-neutral-300">--</strong></span>
        </div>
      </div>

      <!-- Workspace Body Grid -->
      <div class="grid grid-cols-12 flex-1 min-h-[500px]">

        <!-- Left Column: File Explorer Tree -->
        <div class="col-span-12 md:col-span-4 border-r border-neutral-900 flex flex-col bg-black">
          
          <!-- Dropzone -->
          <div class="p-4 border-b border-neutral-900">
            <label id="dropzone" class="border-2 border-dashed border-neutral-800 hover:border-neutral-600 bg-neutral-950 hover:bg-neutral-900/80 rounded-xl p-5 flex flex-col items-center justify-center cursor-pointer transition text-center">
              <i data-lucide="upload-cloud" class="w-6 h-6 text-neutral-400 mb-2"></i>
              <span class="text-xs font-semibold text-white">Drop .ZIP File Here</span>
              <span class="text-[10px] text-neutral-500 mt-0.5">or click to browse from device</span>
              <input type="file" id="zipInput" accept=".zip" class="hidden">
            </label>
          </div>

          <!-- Search Bar -->
          <div class="p-3 border-b border-neutral-900 bg-neutral-950">
            <div class="relative">
              <i data-lucide="search" class="w-3.5 h-3.5 text-neutral-500 absolute left-3 top-2.5"></i>
              <input type="text" id="searchInput" placeholder="Filter files..." class="w-full bg-black border border-neutral-800 rounded-lg pl-8 pr-3 py-1 text-xs text-white placeholder-neutral-600 focus:outline-none focus:border-neutral-600">
            </div>
          </div>

          <!-- Directory Tree -->
          <div id="fileTree" class="flex-1 overflow-y-auto p-2 space-y-0.5 font-mono text-xs">
            <div class="p-12 text-center text-neutral-600 flex flex-col items-center">
              <i data-lucide="folder-closed" class="w-8 h-8 mb-2 opacity-50"></i>
              <span>No archive loaded</span>
            </div>
          </div>
        </div>

        <!-- Right Column: Code & Content Viewer -->
        <div class="col-span-12 md:col-span-8 bg-black flex flex-col">
          
          <!-- Code Viewer Toolbar -->
          <div class="h-11 border-b border-neutral-900 px-4 flex items-center justify-between bg-neutral-950">
            <div class="flex items-center space-x-2 text-xs font-mono text-neutral-300 truncate max-w-[70%]">
              <i data-lucide="file-code" class="w-4 h-4 text-neutral-400 shrink-0"></i>
              <span id="activeFilePath" class="truncate">Select a file to inspect</span>
            </div>

            <div class="flex items-center space-x-2">
              <span id="activeFileMime" class="text-[10px] font-mono bg-neutral-900 border border-neutral-800 text-neutral-400 px-2 py-0.5 rounded">--</span>
              <button id="downloadBtn" class="hidden bg-white hover:bg-neutral-200 text-black font-semibold text-xs px-3 py-1 rounded-lg flex items-center gap-1.5 transition">
                <i data-lucide="download" class="w-3.5 h-3.5"></i> Extract
              </button>
            </div>
          </div>

          <!-- Code / Preview Area -->
          <div id="previewArea" class="flex-1 overflow-auto p-4 flex items-center justify-center">
            <div class="text-center text-neutral-600 flex flex-col items-center max-w-sm">
              <i data-lucide="terminal" class="w-8 h-8 mb-2 opacity-40"></i>
              <p class="text-xs font-medium text-neutral-400">Preview Engine Ready</p>
              <p class="text-[11px] text-neutral-600 mt-1">Select any file from the sidebar to inspect raw code, text, or images.</p>
            </div>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-neutral-900 py-6 text-center text-xs text-neutral-600">
    <p>© 2026 ZipVault — Built for fast, client-side ZIP inspection.</p>
  </footer>

  <script src="/js/app.js"></script>
</body>
</html>