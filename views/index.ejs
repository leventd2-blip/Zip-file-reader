<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ZipVault — Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
    code, pre, .font-mono { font-family: 'JetBrains Mono', monospace; }
  </style>
</head>
<body class="bg-black text-white min-h-screen flex flex-col justify-between font-sans antialiased selection:bg-neutral-800">

  <header class="border-b border-neutral-900 bg-neutral-950 px-6 py-4 flex justify-between items-center">
    <div class="flex items-center space-x-3">
      <div class="bg-neutral-900 border border-neutral-800 p-2 rounded-xl text-white">
        <i data-lucide="archive" class="w-5 h-5"></i>
      </div>
      <div>
        <h1 class="font-bold text-sm tracking-tight">ZipVault</h1>
        <p class="text-[10px] text-neutral-500 font-mono">zipvault.ddns.net</p>
      </div>
    </div>

    <a href="/explorer" class="bg-white hover:bg-neutral-200 text-black font-semibold text-xs px-4 py-2 rounded-xl flex items-center gap-2 transition">
      Launch Explorer <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
    </a>
  </header>

  <main class="flex-1 flex flex-col items-center justify-center p-6 text-center">
    <div class="max-w-md space-y-4">
      <div class="inline-flex items-center space-x-2 bg-neutral-900 border border-neutral-800 px-3 py-1 rounded-full text-xs font-mono text-neutral-400">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Engine Online</span>
      </div>
      <h2 class="text-3xl font-bold tracking-tight">Client-Side Archive Inspection</h2>
      <p class="text-xs text-neutral-400 leading-relaxed">
        Inspect, extract, and preview .ZIP contents instantly in your browser without uploading files to remote servers.
      </p>
      <div class="pt-2">
        <a href="/explorer" class="inline-flex items-center space-x-2 bg-neutral-900 border border-neutral-800 hover:border-neutral-700 px-6 py-3 rounded-xl text-xs font-semibold text-white transition">
          <i data-lucide="folder-open" class="w-4 h-4 text-indigo-400"></i>
          <span>Open Workspace Engine</span>
        </a>
      </div>
    </div>
  </main>

  <footer class="border-t border-neutral-900 px-6 py-4 text-center text-[11px] text-neutral-600 font-mono">
    ZipVault Workspace &copy; 2026
  </footer>

  <script>
    lucide.createIcons();
  </script>
</body>
</html>